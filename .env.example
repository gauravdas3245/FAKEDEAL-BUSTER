# FakeDeal Buster — Environment Configuration Template
# Copy this file to .env in local development. Never commit sensitive values to Git.

# =============================================================================
# Backend Configuration (FastAPI / Uvicorn)
# =============================================================================
HOST=127.0.0.1
PORT=8000
DEBUG=false

# Analytical Database Path (Optional)
# If left blank, the backend auto-resolves with the following precedence:
# 1. artifacts/derived/fakedeal_runtime.duckdb (2.08GB full store if present locally)
# 2. artifacts/derived/fakedeal_demo.duckdb (20.8MB lightweight demo store)
# 3. artifacts/rahul_dataset_handoff/p0000001_all_splits.csv (Unit test CSV fixture)
FAKEDEAL_DATABASE_PATH=artifacts/derived/fakedeal_demo.duckdb

# CORS Allowed Origins (Comma-separated)
# In production, set to your specific frontend URL(s), e.g. https://<your-project>.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
# Optional: strictly scoped regex if using preview branches, e.g. ^https://<project-prefix>.*\.vercel\.app$
CORS_ORIGIN_REGEX=

# =============================================================================
# Frontend Configuration (React / Vite)
# =============================================================================
# In local development, leave blank to use the Vite local proxy (/api -> http://127.0.0.1:8000).
# In production on Vercel, set to your deployed Render backend URL:
# VITE_API_BASE_URL=https://fakedeal-buster-api.onrender.com
VITE_API_BASE_URL=
VITE_DEV_API_TARGET=http://127.0.0.1:8000
